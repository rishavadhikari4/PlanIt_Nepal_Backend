# --- Core ---------------------------------------------------------------
NODE_ENV=development
PORT=5050   # 5000 is taken by macOS AirPlay Receiver
FRONTEND_URL=http://localhost:8080
MONGO_URI=

# --- Payments -----------------------------------------------------------
# 'live' switches both gateways to their production hosts. Anything else uses
# the sandbox hosts, so local and staging never move real money.
PAYMENT_MODE=sandbox

# Khalti ePayment (KPG-2) — secret key from the Khalti merchant dashboard.
# Sandbox runs against https://dev.khalti.com.
# Test wallets: 9800000000-9800000005, MPIN 1111, OTP 987654.
KHALTI_SECRET_KEY=

# Fonepay merchant redirect. Both values are issued by your acquiring bank,
# not by Fonepay directly. Leave blank to hide Fonepay at checkout.
FONEPAY_MERCHANT_CODE=
FONEPAY_SECRET_KEY=

# --- Mail (existing) ----------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_REFRESH_TOKEN=
